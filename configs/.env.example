# DeepSeek / OpenAI-compatible route 2 examples
OPENAI_API_KEY=your-key
DEEPSEEK_API_KEY=your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek/deepseek-v4-flash
LLM_TEMPERATURE=0.2

# 允许轨迹检测
CREWAI_TRACING_ENABLED=true

# 火山引擎LLM
VOLCENGINE_API_KEY=your_key
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCENGINE_MODEL_NAME=doubao-seed-2.0-lite

# 公司内网大模型
# OPENAI_API_KEY=内网key
# OPENAI_BASE_URL=内网地址
# OPENAI_MODEL_NAME=内网模型名
# NO_PROXY=mlops网址